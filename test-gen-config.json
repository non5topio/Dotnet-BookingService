{
    "enabled": "true",
    "increase-coverage": {
      "project-name": "dotnet-booking-service",
      "target-branches": [
        "main"
      ],
      "test-env-docker-stage": "test",
      "build-test-env-docker-stage-script-path": "tool/build-test-env-docker-stage.sh",
      "test-files-folders": [
        "BookingService.Tests/BookingControllerTest.cs"
      ],
      "source-test-file-paths": [
        {
          "source-file-path": "BookingService/Controllers/BookingController.cs",
          "test-file-path": "BookingService.Tests/BookingControllerTest.cs"
        }
      ],
      "test-command": "dotnet test",
      "coverage-type": "cobertura",
      "code-coverage-report-path": "BookingService.Tests/TestResults/coverage.cobertura.xml",
      "desired-coverage": 100,
      "max-iterations": 1,
      "max-number-of-test-cases": 6
      }
  }